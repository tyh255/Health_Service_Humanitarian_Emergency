  geom_contour(aes(z = tval), colour = bad_col, linewidth = 1.1, breaks = -t_crit) +
  geom_point(data = bnd, aes(r2dz.x, r2yz.dx), colour = ok_col, size = 3) +
  geom_text(data = bnd, aes(r2dz.x, r2yz.dx, label = bound_label),
