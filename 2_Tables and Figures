plot_sensitivity <- function(grid, x_var, x_label, x_scale_fn = NULL,
                             mbar_label_at = NULL) {
  df_plot <- grid %>%
    mutate(window_label = factor(
      ifelse(window_size == 1, "Shock year (event-time 0)",
             "Years 1\u20133 average (event-times 0\u20132)"),
      levels = c("Shock year (event-time 0)",
                 "Years 1\u20133 average (event-times 0\u20132)")),
      growth_label = factor(
        ifelse(growth_threshold == 0.5, "Annual growth threshold: 50%",
               "Annual growth threshold: 100%"),
        levels = c("Annual growth threshold: 50%",
                   "Annual growth threshold: 100%")))

  # nearest-gridpoint matching; never %in% on seq()-generated doubles
  unique_x <- sort(unique(df_plot[[x_var]]))
  label_x <- if (is.null(mbar_label_at)) {
    unique_x[seq(1, length(unique_x), by = 4)]
  } else {
    vapply(mbar_label_at, function(v) unique_x[which.min(abs(unique_x - v))],
           numeric(1))
  }
  df_labels <- df_plot %>%
    dplyr::filter(.data[[x_var]] %in% label_x, window_size == 1,
                  !is.na(cs_breakdown_mbar)) %>%
    mutate(mbar_lab = fmt_mbar(cs_breakdown_mbar))

  wc <- c("Shock year (event-time 0)" = "#2C3E50",
          "Years 1\u20133 average (event-times 0\u20132)" = "#E08214")
  wl <- c("Shock year (event-time 0)" = "solid",
          "Years 1\u20133 average (event-times 0\u20132)" = "longdash")

  p <- ggplot(df_plot, aes(x = .data[[x_var]], color = window_label,
                           fill = window_label, linetype = window_label)) +
    geom_ribbon(aes(ymin = cs_lo, ymax = cs_hi), alpha = 0.15, color = NA) +
    geom_line(aes(y = cs_est), linewidth = 0.5) +
    geom_point(aes(y = cs_est), size = 0.9) +
    geom_hline(yintercept = 0, linetype = "dashed", color = "gray40",
               linewidth = 0.3) +
    ggrepel::geom_text_repel(
      data = df_labels, aes(y = cs_est, label = mbar_lab),
      size = 2.2, color = "gray20", bg.color = "white", bg.r = 0.15,
      segment.size = 0.2, box.padding = 0.3, seed = 42, show.legend = FALSE,
      family = "Helvetica") +
    facet_wrap(~ growth_label, ncol = 2) +
    scale_color_manual(values = wc, name = NULL) +
    scale_fill_manual(values = wc, name = NULL) +
    scale_linetype_manual(values = wl, name = NULL) +
    theme_nc_fig2() +
    labs(x = x_label, y = "Estimated change in vaccination coverage (pp)")
  if (!is.null(x_scale_fn)) p <- p + x_scale_fn
  p
}

