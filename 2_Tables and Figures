MBAR_MAX_FIG <- MBAR_MAX

fmt_mbar <- function(m, mmax = MBAR_MAX_FIG) {
  case_when(
    is.na(m) ~ NA_character_,
    m > mmax ~ sprintf("M\u0304 > %d", mmax),
    TRUE     ~ paste0("M\u0304 = ", sub("\\.$", "", sub("0+$", "", sprintf("%.2f", m))))
  )
}

# deterministic per-spec seed -- the did bootstrap and HonestDiD hybrid
# test are stochastic, so this keeps figure and table CIs identical
spec_seed <- function(threshold, growth_t, window_size) {
  as.integer((round(threshold * 1000) + round(growth_t * 1e5) * 7L +
                window_size * 13L) %% .Machine$integer.max)
}

run_sensitivity_grid <- function(df, displacement_var, threshold, growth_t,
                                 window_size = 3) {
  set.seed(spec_seed(threshold, growth_t, window_size))

  df_shocks <- build_cyv_shock_panel(displacement_var, threshold, growth_t,
                                     window_size, base_df = df)

  na_row <- tibble(cs_est = NA_real_, cs_se = NA_real_,
                   cs_lo = NA_real_, cs_hi = NA_real_,
                   cs_breakdown_mbar = NA_real_,
                   robust_lo_mbar1 = NA_real_, robust_hi_mbar1 = NA_real_,
                   n_treated_units = NA_integer_, cs_xformla = NA_character_)
  if (sum(df_shocks$post, na.rm = TRUE) < 5) return(na_row)

  cs_data <- df_shocks %>%
    mutate(g_var = if_else(treat == 1L, as.integer(first_shock_year), 0L),
           id_int = as.integer(as.factor(id_var)),
           Year = as.integer(Year)) %>%
    dplyr::filter(!is.na(Coverage))

  # identical estimator to the headline tables (GDP-adjusted, reg)
  cs_att <- tryCatch(
    suppressWarnings(did::att_gt(
      yname = "Coverage", tname = "Year", idname = "id_int", gname = "g_var",
      xformla = ~ GDP_lag, data = cs_data %>% dplyr::filter(!is.na(GDP_lag)),
      control_group = "nevertreated", clustervars = "Country.Code",
      panel = TRUE, allow_unbalanced_panel = TRUE,
      base_period = "universal", est_method = "reg",
      bstrap = TRUE, biters = 1000, cband = FALSE, print_details = FALSE)),
    error = function(e) NULL)
  cs_xformla_used <- if (!is.null(cs_att)) "GDP_lag" else NA_character_
  if (is.null(cs_att)) {
    cs_att <- tryCatch(
      suppressWarnings(did::att_gt(
        yname = "Coverage", tname = "Year", idname = "id_int", gname = "g_var",
        data = cs_data, control_group = "nevertreated", clustervars = "Country.Code",
        panel = TRUE, allow_unbalanced_panel = TRUE, base_period = "universal",
        bstrap = TRUE, biters = 1000, cband = FALSE, print_details = FALSE)),
      error = function(e) NULL)
    if (!is.null(cs_att)) cs_xformla_used <- "unadjusted"
  }
  if (is.null(cs_att)) return(na_row)

  cs_win <- tryCatch(
    did::aggte(cs_att, type = "dynamic", min_e = 0, max_e = window_size - 1,
               na.rm = TRUE), error = function(e) NULL)
  cs_est <- if (!is.null(cs_win)) cs_win$overall.att else NA_real_
  cs_se  <- if (!is.null(cs_win)) cs_win$overall.se  else NA_real_

  hdid <- run_honestdid_sensitivity(cs_att, min_e = -3,
                                    max_e = window_size - 1, aggregate = TRUE)

  tibble(cs_est = cs_est, cs_se = cs_se,
         cs_lo = cs_est - 1.96 * cs_se, cs_hi = cs_est + 1.96 * cs_se,
         cs_breakdown_mbar = hdid$cs_breakdown_mbar,
         robust_lo_mbar1 = hdid$robust_lo_mbar1,
         robust_hi_mbar1 = hdid$robust_hi_mbar1,
         n_treated_units = length(unique(cs_data$Country.Code[cs_data$g_var > 0])),
         cs_xformla = cs_xformla_used)
}

