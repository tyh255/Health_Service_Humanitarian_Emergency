# S2 — EVENT STUDY TABLES (Corrected TWFE · CS · Sun-Abraham)
# ------------------------------------------------------------

run_event_study <- function(df, threshold, growth_t,
                            displacement_var = "unhcr_total_displaced",
                            window_min = -5, window_max = 6,
                            hdid_pre_window = -3) {

  df_shocks <- build_cyv_shock_panel(displacement_var, threshold, growth_t,
                                     window_size = 1, base_df = df)

  # estimator 1: corrected TWFE event study, never-treated as reference
  df_es <- df_shocks %>%
    mutate(event_time_capped = case_when(
      treat == 0L             ~ -1L,
      is.na(event_time)       ~ -1L,
      event_time < window_min ~ -1L,
      event_time > window_max ~ -1L,
      TRUE                    ~ as.integer(event_time)))
  es_twfe <- feols(
    Coverage ~ i(event_time_capped, ref = -1) + GDP_lag + conflict_tier | id_var + Year,
    data = df_es, cluster = ~Country.Code)
  twfe_event_df <- broom::tidy(es_twfe, conf.int = TRUE) %>%
    dplyr::filter(grepl("event_time_capped::", term)) %>%
    mutate(event_time = as.integer(gsub("event_time_capped::", "", term)),
           estimator = "Corrected TWFE") %>%
    dplyr::select(estimator, event_time, estimate, std.error,
                  conf.low, conf.high, p.value) %>%
    bind_rows(tibble(estimator = "Corrected TWFE", event_time = -1L,
                     estimate = 0, std.error = 0,
                     conf.low = 0, conf.high = 0, p.value = NA_real_)) %>%
    arrange(event_time)

  # estimator 2: CS, aligned to the headline spec (GDP_lag, reg, id_int)
  cs_data <- df_shocks %>%
    mutate(g_var  = if_else(treat == 1L, as.integer(first_shock_year), 0L),
           id_int = as.integer(as.factor(id_var)),
           Year   = as.integer(Year)) %>%
    dplyr::filter(!is.na(Coverage))
  cs_att <- tryCatch(
    suppressWarnings(did::att_gt(
      yname = "Coverage", tname = "Year", idname = "id_int", gname = "g_var",
      xformla = ~ GDP_lag, data = cs_data %>% dplyr::filter(!is.na(GDP_lag)),
      control_group = "nevertreated", clustervars = "Country.Code",
      panel = TRUE, allow_unbalanced_panel = TRUE,
      base_period = "universal", est_method = "reg", print_details = FALSE)),
    error = function(e) NULL)
  if (is.null(cs_att)) {
    message(sprintf("  [CS fallback] threshold=%s growth=%s", threshold, growth_t))
    cs_att <- suppressWarnings(did::att_gt(
      yname = "Coverage", tname = "Year", idname = "id_int", gname = "g_var",
      data = cs_data, control_group = "nevertreated", clustervars = "Country.Code",
      panel = TRUE, allow_unbalanced_panel = TRUE,
      base_period = "universal", print_details = FALSE))
  }
  cs_dyn <- did::aggte(cs_att, type = "dynamic",
                       min_e = window_min, max_e = window_max, na.rm = TRUE)

  post_ets <- as.integer(cs_dyn$egt[cs_dyn$egt >= 0])
  mbar_df <- map_dfr(post_ets, function(et) {
    hdid <- tryCatch(
      run_honestdid_sensitivity(cs_att, event_time = et,
                                min_e = hdid_pre_window, max_e = window_max),
      error = function(e) list(cs_breakdown_mbar = NA_real_,
                               robust_lo_mbar1 = NA_real_,
                               robust_hi_mbar1 = NA_real_))
    tibble(event_time = et,
           cs_breakdown_mbar = hdid$cs_breakdown_mbar,
           robust_lo_mbar1 = hdid$robust_lo_mbar1,
           robust_hi_mbar1 = hdid$robust_hi_mbar1)
  })

  cs_event_df <- tibble(
    estimator = "Callaway-Sant'Anna",
    event_time = as.integer(cs_dyn$egt),
    estimate = cs_dyn$att.egt, std.error = cs_dyn$se.egt) %>%
    mutate(conf.low = estimate - 1.96 * std.error,
           conf.high = estimate + 1.96 * std.error,
           p.value = 2 * pnorm(-abs(estimate / std.error))) %>%
    left_join(mbar_df, by = "event_time")

  # estimator 3: Sun-Abraham. conflict_tier deliberately omitted from the
  # covariates here (time-varying, plausibly post-treatment).
  sa_data <- df_shocks %>%
    mutate(cohort_sun = if_else(treat == 1L, as.integer(first_shock_year), 10000L)) %>%
    dplyr::filter(!is.na(Coverage))
  m_sa <- tryCatch(
    feols(Coverage ~ sunab(cohort_sun, Year) + GDP_lag | id_var + Year,
          data = sa_data, cluster = ~Country.Code), error = function(e) NULL)
  empty_sa <- tibble(estimator = character(0), event_time = integer(0),
                     estimate = numeric(0), std.error = numeric(0),
                     conf.low = numeric(0), conf.high = numeric(0),
                     p.value = numeric(0))
  sa_event_df <- if (is.null(m_sa)) empty_sa else {
    # fixest names the aggregated per-period sunab coefs "Year::<rel time>";
    # if your version names them differently the guard returns empty + warns
    sa_ct <- summary(m_sa)$coeftable
    keep <- grepl("^Year::-?[0-9]+$", rownames(sa_ct))
    if (!any(keep)) {
      warning("Sun-Abraham: couldn't parse per-period coefs; check fixest version.")
      empty_sa
    } else {
      sa_ct <- sa_ct[keep, , drop = FALSE]
      tibble(estimator = "Sun-Abraham",
             event_time = as.integer(sub("^Year::(-?[0-9]+)$", "\\1", rownames(sa_ct))),
             estimate = sa_ct[, 1], std.error = sa_ct[, 2]) %>%
        mutate(conf.low = estimate - 1.96 * std.error,
               conf.high = estimate + 1.96 * std.error,
               p.value = 2 * pnorm(-abs(estimate / std.error))) %>%
        dplyr::filter(event_time >= window_min & event_time <= window_max) %>%
        bind_rows(tibble(estimator = "Sun-Abraham", event_time = -1L,
                         estimate = 0, std.error = 0,
                         conf.low = 0, conf.high = 0, p.value = NA_real_)) %>%
        arrange(event_time)
    }
  }

  bind_rows(twfe_event_df, cs_event_df, sa_event_df) %>%
    mutate(estimator = factor(estimator,
                              levels = c("Corrected TWFE", "Callaway-Sant'Anna",
                                         "Sun-Abraham"))) %>%
    arrange(estimator, event_time)
}

