  droplevels()

ovb_fml <- Coverage ~ post + conflict_tier + GDP_lag | id_var + Year
m_clust <- feols(ovb_fml, data = ovb_frame, cluster = ~Country.Code)
m_iid   <- feols(ovb_fml, data = ovb_frame, vcov = "iid")

bench <- c("GDP_lag", grep("^conflict_tier", names(coef(m_iid)), value = TRUE))
sens <- sensemakr(model = m_iid, treatment = "post",
                  benchmark_covariates = bench,
                  kd = 1:3, ky = 1:3, q = 1, alpha = 0.05, reduce = TRUE)

b_post    <- unname(coef(m_clust)["post"])
se_clust  <- unname(sqrt(diag(vcov(m_clust)))["post"])
dof_clust <- n_distinct(ovb_frame$Country.Code) - 1L
se_class  <- as.numeric(sens$sensitivity_stats$se)
dof_class <- as.numeric(sens$sensitivity_stats$dof)
