gA <- expand.grid(r2dz = seq(1e-4, 0.09, length.out = 300),
                  r2yz = seq(1e-4, 0.055, length.out = 300))
gA$est <- adjusted_estimate(estimate = b_post, r2dz.x = gA$r2dz,
                            r2yz.dx = gA$r2yz, se = se_class,
                            dof = dof_class, reduce = TRUE)
pA <- ggplot(gA, aes(r2dz, r2yz)) +
  geom_contour(aes(z = est), colour = "grey70", linewidth = 0.3,
