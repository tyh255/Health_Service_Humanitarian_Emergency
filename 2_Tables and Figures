run_alt_control_did <- function(disp_var, threshold, growth_t, window_size,
                                control_data, control_var,
                                baseline_data, baseline_var, threshold_label) {
  df_shocks <- build_cyv_shock_panel(disp_var, threshold, growth_t, window_size) %>%
    left_join(control_data,  by = c("Country.Code", "Year")) %>%
    left_join(baseline_data, by = "Country.Code")

  na_row <- tibble(threshold = threshold_label, growth = paste0(growth_t * 100, "%"),
                   window = ifelse(window_size == 1, "Year 1", "Years 1-3"),
                   n_treated_ctry = NA_integer_, n_obs = NA_integer_,
                   twfe_none = "\u2014", twfe_low = "\u2014", twfe_war = "\u2014",
                   twfe_joint_p = "\u2014", cs_att = "\u2014",
                   cs_xformla = "\u2014", cs_breakdown_mbar = "\u2014")

  df_mod <- df_shocks %>%
    dplyr::filter(treat == 0L |
                    (treat == 1L & event_time >= -5 & event_time <= window_size - 1),
                  !is.na(.data[[control_var]]))
  if (sum(df_mod$post, na.rm = TRUE) == 0) return(na_row)

  fml <- as.formula(sprintf(
    "Coverage ~ post * conflict_tier + %s | id_var + Year", control_var))
  m <- tryCatch(feols(fml, data = df_mod, cluster = ~Country.Code),
                error = function(e) NULL)
  if (is.null(m)) return(na_row)
  eff <- per_tier_post_effects(m)
  intx_p <- safe_wald_p(m, "post:conflict_tier")

  cs_data <- df_shocks %>%
    mutate(g_var = if_else(treat == 1L, as.integer(first_shock_year), 0L),
           id_int = as.integer(as.factor(id_var)),
           Year = as.integer(Year)) %>%
    dplyr::filter(!is.na(Coverage), !is.na(.data[[baseline_var]]))

  cs_attempt_msg <- NULL
  cs_att_object <- tryCatch(
    suppressWarnings(did::att_gt(
      yname = "Coverage", tname = "Year", idname = "id_int", gname = "g_var",
      xformla = as.formula(paste("~", baseline_var)), data = cs_data,
      control_group = "nevertreated", clustervars = "Country.Code",
      panel = TRUE, allow_unbalanced_panel = TRUE,
      base_period = "universal", est_method = "reg", print_details = FALSE)),
    error = function(e) { cs_attempt_msg <<- conditionMessage(e); NULL })
  cs_xformla_used <- if (!is.null(cs_att_object))
    sub("_baseline$", "", baseline_var) else NA_character_
  if (is.null(cs_att_object)) {
    # log it -- silent fallbacks burned us once already
    message(sprintf("  [CS fallback] %s | %s: %s", threshold_label, baseline_var,
                    ifelse(is.null(cs_attempt_msg), "unknown", cs_attempt_msg)))
    cs_att_object <- tryCatch(
      suppressWarnings(did::att_gt(
        yname = "Coverage", tname = "Year", idname = "id_int", gname = "g_var",
        data = cs_data, control_group = "nevertreated", clustervars = "Country.Code",
        panel = TRUE, allow_unbalanced_panel = TRUE,
        base_period = "universal", print_details = FALSE)),
      error = function(e) NULL)
    if (!is.null(cs_att_object)) cs_xformla_used <- "fallback (unadjusted)"
  }

  cs_simple_att <- NA_real_; cs_simple_se <- NA_real_; cs_breakdown_mbar <- NA_real_
  if (!is.null(cs_att_object)) {
    cs_win <- tryCatch(
      did::aggte(cs_att_object, type = "dynamic",
                 min_e = 0, max_e = window_size - 1, na.rm = TRUE),
      error = function(e) NULL)
    if (!is.null(cs_win)) {
      cs_simple_att <- cs_win$overall.att; cs_simple_se <- cs_win$overall.se
    }
    hdid <- run_honestdid_sensitivity(cs_att_object, event_time = 0, min_e = -3,
                                      max_e = window_size - 1,
                                      aggregate = (window_size > 1))
    cs_breakdown_mbar <- hdid$cs_breakdown_mbar
  }
  cs_breakdown_str <- if (is.na(cs_breakdown_mbar)) "\u2014" else
    if (cs_breakdown_mbar > MBAR_MAX) sprintf(">%.1f", MBAR_MAX) else
      sprintf("%.2f", cs_breakdown_mbar)

  tibble(
    threshold = threshold_label, growth = paste0(growth_t * 100, "%"),
    window = ifelse(window_size == 1, "Year 1", "Years 1-3"),
    n_treated_ctry = length(unique(df_mod$Country.Code[df_mod$treat == 1L & df_mod$post == 1L])),
    n_obs = nobs(m),
    twfe_none = fmt_est_ci(eff$none["est"], eff$none["se"]),
    twfe_low  = fmt_est_ci(eff$low["est"],  eff$low["se"]),
    twfe_war  = fmt_est_ci(eff$war["est"],  eff$war["se"]),
    twfe_joint_p = ifelse(is.na(intx_p), "\u2014", sprintf("%.3f", intx_p)),
    cs_att = fmt_est_ci(cs_simple_att, cs_simple_se),
    cs_xformla = ifelse(is.na(cs_xformla_used), "\u2014", cs_xformla_used),
    cs_breakdown_mbar = cs_breakdown_str)
}

