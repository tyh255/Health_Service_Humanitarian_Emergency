make_cor_panel <- function(cor_mat, tag) {
  cl <- as.data.frame(cor_mat) %>%
    tibble::rownames_to_column("v1") %>%
    pivot_longer(-v1, names_to = "v2", values_to = "rho") %>%
    mutate(v1 = factor(v1, levels = rownames(cor_mat)),
           v2 = factor(v2, levels = rev(rownames(cor_mat))))
  ggplot(cl, aes(v1, v2, fill = rho)) +
    geom_tile(color = "white", linewidth = 0.2) +
    geom_text(aes(label = sprintf("%.2f", rho)), size = 1.6) +
    scale_fill_distiller(palette = "RdBu", direction = -1, limits = c(-1, 1),
                         name = "Spearman \u03c1") +
    coord_fixed() +
    scale_x_discrete(expand = c(0, 0)) + scale_y_discrete(expand = c(0, 0)) +
    labs(x = NULL, y = NULL, tag = tag) +
    theme_nc() +
    theme(axis.text.x = element_text(angle = 45, hjust = 1, size = 5.5),
          axis.text.y = element_text(size = 5.5),
          axis.line = element_blank(), axis.ticks = element_blank(),
          panel.grid.major.y = element_blank(),
          legend.position = "right",
          legend.key.height = unit(14, "pt"), legend.key.width = unit(5, "pt"))
}

