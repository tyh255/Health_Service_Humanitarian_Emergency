# (b) t-contour: classical bias scaling, clustered SE + G-1 dof for the test
t_crit <- qt(0.975, df = dof_clust)
gB <- expand.grid(r2dz = seq(1e-4, 0.06, length.out = 300),
                  r2yz = seq(1e-4, 0.035, length.out = 300))
gB$adj_est <- adjusted_estimate(estimate = b_post, r2dz.x = gB$r2dz,
                                r2yz.dx = gB$r2yz, se = se_class,
                                dof = dof_class, reduce = TRUE)
gB$adj_se <- se_clust * sqrt((1 - gB$r2yz) / (1 - gB$r2dz)) *
  sqrt(dof_clust / (dof_clust - 1))
gB$tval <- gB$adj_est / gB$adj_se
pB <- ggplot(gB, aes(r2dz, r2yz)) +
  geom_contour(aes(z = tval), colour = "grey70", linewidth = 0.3,
