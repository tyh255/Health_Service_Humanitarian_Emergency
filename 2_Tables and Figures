build_cs_event_study <- function(df, threshold, growth_t,
                                 window_min = -5, window_max = 6,
                                 hdid_max_event_time = 2,
                                 spec_label = NA_character_) {

  df_shocks <- build_cyv_shock_panel("unhcr_total_displaced", threshold,
                                     growth_t, window_size = 1, base_df = df)
  cs_data <- df_shocks %>%
    mutate(g_var = if_else(treat == 1L, as.integer(first_shock_year), 0L),
           id_int = as.integer(as.factor(id_var)),
           Year = as.integer(Year)) %>%
    dplyr::filter(!is.na(Coverage))
  if (sum(cs_data$g_var > 0) < 10) return(tibble(event_time = integer(0)))

  cs_att <- tryCatch(
    suppressWarnings(did::att_gt(
      yname = "Coverage", tname = "Year", idname = "id_int", gname = "g_var",
      xformla = ~ GDP_lag, data = cs_data %>% dplyr::filter(!is.na(GDP_lag)),
      control_group = "nevertreated", clustervars = "Country.Code",
      panel = TRUE, allow_unbalanced_panel = TRUE,
      base_period = "universal", est_method = "reg",
      bstrap = TRUE, biters = 1000, cband = FALSE, print_details = FALSE)),
    error = function(e) NULL)
  if (is.null(cs_att)) return(tibble(event_time = integer(0)))

  cs_dyn <- tryCatch(did::aggte(cs_att, type = "dynamic",
                                min_e = window_min, max_e = window_max,
                                na.rm = TRUE), error = function(e) NULL)
  if (is.null(cs_dyn)) return(tibble(event_time = integer(0)))

  result <- tibble(event_time = as.integer(cs_dyn$egt),
                   estimate = cs_dyn$att.egt, std.error = cs_dyn$se.egt) %>%
    mutate(conf.low = estimate - 1.96 * std.error,
           conf.high = estimate + 1.96 * std.error,
           spec_label = spec_label) %>%
    dplyr::filter(event_time != -1)   # reference row is 0 by construction

  # HonestDiD robust CIs only inside the analytical window
  result$robust_lo <- result$conf.low
  result$robust_hi <- result$conf.high
  for (i in seq_len(nrow(result))) {
    et <- result$event_time[i]
    if (et < 0 || et > hdid_max_event_time) next
    hdid <- tryCatch(
      run_honestdid_sensitivity(cs_att, event_time = et, min_e = -3,
                                max_e = hdid_max_event_time),
      error = function(e) NULL)
    if (!is.null(hdid) && !is.na(hdid$robust_lo_mbar1)) {
      result$robust_lo[i] <- hdid$robust_lo_mbar1
      result$robust_hi[i] <- hdid$robust_hi_mbar1
    }
  }
  result
}

