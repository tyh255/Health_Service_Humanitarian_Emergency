sig_stars <- function(p) {
  if (is.na(p)) return("")
  if (p < 0.001) "***" else if (p < 0.01) "**" else
    if (p < 0.05) "*" else if (p < 0.10) "\u2020" else ""
}
fmt_est_ci <- function(est, se) {
  if (is.na(est) || is.na(se)) return("\u2014")
  p <- 2 * pnorm(-abs(est / se))
  sprintf("%.2f%s (%.2f, %.2f)", est, sig_stars(p), est - 1.96 * se, est + 1.96 * se)
}
fmt_tidy_row <- function(tr) {
  if (nrow(tr) == 0) return("\u2014")
  sprintf("%.2f%s (%.2f, %.2f)", tr$estimate, sig_stars(tr$p.value),
          tr$conf.low, tr$conf.high)
}
safe_wald_p <- function(model, pattern) {
  w <- tryCatch(fixest::wald(model, keep = pattern), error = function(e) NULL)
  if (is.null(w)) return(NA_real_)
  w$p
}
per_tier_post_effects <- function(model, tier_var = "conflict_tier") {
  if (is.null(model)) return(list(none = c(est = NA_real_, se = NA_real_),
                                  low  = c(est = NA_real_, se = NA_real_),
                                  war  = c(est = NA_real_, se = NA_real_)))
  cf <- names(coef(model))
  nm_low <- grep(sprintf("^post:%s.*Low", tier_var), cf, value = TRUE)[1]
  nm_war <- grep(sprintf("^post:%s.*War", tier_var), cf, value = TRUE)[1]
  list(
    none = lincom(model, "post"),
    low  = if (!is.na(nm_low)) lincom(model, c("post", nm_low)) else c(est = NA_real_, se = NA_real_),
    war  = if (!is.na(nm_war)) lincom(model, c("post", nm_war)) else c(est = NA_real_, se = NA_real_)
  )
}

# generic shock panel for arbitrary displacement variable. mirrors the
# main code exactly, including id_var (the country x vaccine unit).
build_cyv_shock_panel <- function(disp_var, threshold, growth_t, window_size,
                                  base_df = vaccine_long_updated) {
  base_df %>%
    group_by(Country.Code, vaccine) %>%
    arrange(Year, .by_group = TRUE) %>%
    mutate(
      lag_disp = dplyr::lag(.data[[disp_var]]),
      growth   = if_else(!is.na(lag_disp) & lag_disp > 0,
                         (.data[[disp_var]] - lag_disp) / lag_disp, NA_real_),
      shock = case_when(
        is.na(growth) ~ 0L,
        growth >= growth_t & .data[[disp_var]] >= threshold ~ 1L,
        TRUE ~ 0L)
    ) %>%
    group_by(Country.Code) %>%
    mutate(
      first_shock_year = if (any(shock == 1, na.rm = TRUE))
        min(Year[shock == 1], na.rm = TRUE) else NA_real_,
      treat      = if_else(!is.na(first_shock_year), 1L, 0L),
      event_time = Year - first_shock_year
    ) %>%
    ungroup() %>%
    mutate(
      post = if_else(!is.na(event_time) & event_time >= 0 &
                       event_time < window_size, 1L, 0L),
      conflict_tier = factor(case_when(
        brd_new >= 1000 ~ "War",
        brd_new >= 25   ~ "Low-level",
        TRUE            ~ "None"), levels = c("None", "Low-level", "War")),
      id_var = paste(Country.Code, vaccine, sep = "_")
    )
}


# ------------------------------------------------------------
# S1 + ST10 — TWFE DECOMPOSITION
# ------------------------------------------------------------
# splits the post * conflict_tier interaction into main effects,
# interaction terms (the additivity test), and the combined per-tier ATTs.

run_twfe_decomposition <- function(disp_var, threshold, growth_t, window_size,
                                   threshold_label) {
  df_shocks <- build_cyv_shock_panel(disp_var, threshold, growth_t, window_size)
  df_mod <- df_shocks %>%
    dplyr::filter(treat == 0L |
                    (treat == 1L & event_time >= -5 & event_time <= window_size - 1))
  if (sum(df_mod$post, na.rm = TRUE) == 0) return(NULL)

  m <- tryCatch(
    feols(Coverage ~ post * conflict_tier + GDP_lag | id_var + Year,
          data = df_mod, cluster = ~Country.Code), error = function(e) NULL)
  if (is.null(m)) return(NULL)

  res <- broom::tidy(m, conf.int = TRUE, conf.level = 0.95)
  pull_term <- function(tn) res %>% dplyr::filter(term == tn)
  eff <- per_tier_post_effects(m)
  intx_p <- safe_wald_p(m, "post:conflict_tier")

  tibble(
    threshold      = threshold_label,
    growth         = paste0(growth_t * 100, "%"),
    window         = ifelse(window_size == 1, "Year 1", "Years 1-3"),
    n_treated_ctry = length(unique(df_mod$Country.Code[df_mod$treat == 1L & df_mod$post == 1L])),
    n_obs          = nobs(m),
    post_main      = fmt_tidy_row(pull_term("post")),
    conflict_low   = fmt_tidy_row(pull_term("conflict_tierLow-level")),
    conflict_war   = fmt_tidy_row(pull_term("conflict_tierWar")),
    intx_post_low  = fmt_tidy_row(pull_term("post:conflict_tierLow-level")),
    intx_post_war  = fmt_tidy_row(pull_term("post:conflict_tierWar")),
    intx_joint_p   = ifelse(is.na(intx_p), "\u2014", sprintf("%.3f", intx_p)),
    combined_none  = fmt_est_ci(eff$none["est"], eff$none["se"]),
    combined_low   = fmt_est_ci(eff$low["est"],  eff$low["se"]),
    combined_war   = fmt_est_ci(eff$war["est"],  eff$war["se"])
  )
}

