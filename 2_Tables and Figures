  grid %>%
    group_by(!!sym(x_var)) %>%
    summarise(mean_fit = mean(fit), mean_se = mean(se), .groups = "drop") %>%
    arrange(!!sym(x_var)) %>%
    mutate(lower = mean_fit - 1.96 * mean_se, upper = mean_fit + 1.96 * mean_se)
}
curve_for <- function(model, x_var, x_seq, data = df_full) {
  make_grid_uni(x_var, x_seq, data %>% filter(!is.na(.data[[x_var]]))) %>%
    predict_marginal_f4(model, .) %>%
    aggregate_curve_f4(x_var)
}

