# ------------------------------------------------------------
# ST9 — BASELINE WAR ASSOCIATION WITH COVERAGE
# ------------------------------------------------------------
# how much does armed conflict itself associate with measured coverage,
# independent of the displacement-shock machinery. full-panel TWFE
# variants plus staggered-robust war-onset CS and SA.

WAR_BRD_CUT       <- 1000
LOW_BRD_CUT       <- 25
WAR_MIN_PRE_YEARS <- 1      # onset needs at least this many observed war-free years
QUIET_ABS_T       <- 250000 # displacement-shock definition for the "quiet" sample
QUIET_GROWTH_T    <- 0.50
QUIET_WINDOW      <- 3

war_panel <- vaccine_long_updated %>%
  group_by(Country.Code, vaccine) %>%
  arrange(Year, .by_group = TRUE) %>%
  mutate(brd_lag1 = dplyr::lag(brd_new)) %>%
  ungroup() %>%
  mutate(
    id_var = paste(Country.Code, vaccine, sep = "_"),
    brd_fill = coalesce(brd_new, 0),
    conflict_tier = factor(case_when(
      brd_fill >= WAR_BRD_CUT ~ "War",
      brd_fill >= LOW_BRD_CUT ~ "Low-level",
      TRUE ~ "None"), levels = c("None", "Low-level", "War")),
    war_bin = as.integer(brd_fill >= WAR_BRD_CUT),
    log_brd = log1p(brd_fill),
    conflict_tier_lag = factor(case_when(
      is.na(brd_lag1)         ~ NA_character_,
      brd_lag1 >= WAR_BRD_CUT ~ "War",
      brd_lag1 >= LOW_BRD_CUT ~ "Low-level",
      TRUE ~ "None"), levels = c("None", "Low-level", "War"))
  ) %>%
  group_by(Country.Code) %>%
  mutate(
    first_year_obs = min(Year, na.rm = TRUE),
    first_war_year = if (any(war_bin == 1L, na.rm = TRUE))
      min(Year[war_bin == 1L], na.rm = TRUE) else NA_real_,
    ever_war = !is.na(first_war_year),
    # left-censored "onsets" (war in the first observed year) aren't onsets
    clean_onset = ever_war & (first_war_year >= first_year_obs + WAR_MIN_PRE_YEARS),
    war_event_time = Year - first_war_year
  ) %>%
  ungroup()

twfe_war_rows <- function(model, spec_label, sample_label, terms_map) {
  if (is.null(model)) {
    return(tibble(specification = spec_label, sample = sample_label,
                  estimand = names(terms_map), estimate = "\u2014",
                  n_obs = NA_integer_, n_war_ctry = NA_integer_,
                  notes = "model failed"))
  }
  res <- broom::tidy(model)
  map_dfr(names(terms_map), function(lbl) {
    r <- res %>% dplyr::filter(term == terms_map[[lbl]])
    tibble(specification = spec_label, sample = sample_label, estimand = lbl,
           estimate = if (nrow(r) == 1) fmt_est_ci(r$estimate, r$std.error) else "\u2014",
           n_obs = nobs(model), n_war_ctry = NA_integer_, notes = "")
  })
}

m_tier <- feols(Coverage ~ conflict_tier + GDP_lag | id_var + Year,
                data = war_panel, cluster = ~Country.Code)
m_bin  <- feols(Coverage ~ war_bin + GDP_lag | id_var + Year,
                data = war_panel, cluster = ~Country.Code)
m_lag  <- feols(Coverage ~ conflict_tier_lag + GDP_lag | id_var + Year,
                data = war_panel %>% dplyr::filter(!is.na(conflict_tier_lag)),
                cluster = ~Country.Code)
m_brd  <- feols(Coverage ~ log_brd + GDP_lag | id_var + Year,
                data = war_panel, cluster = ~Country.Code)

rows_A <- twfe_war_rows(m_tier, "TWFE, contemporaneous conflict tier", "Full panel",
                        c("Low-level (25\u2013999 brd)" = "conflict_tierLow-level",
                          "War (\u22651,000 brd)"        = "conflict_tierWar"))
rows_B <- twfe_war_rows(m_bin, "TWFE, binary war indicator", "Full panel",
                        c("War year (\u22651,000 brd)" = "war_bin"))
rows_C <- twfe_war_rows(m_lag, "TWFE, conflict tier lagged 1 year", "Full panel",
                        c("Low-level, t\u22121" = "conflict_tier_lagLow-level",
                          "War, t\u22121"        = "conflict_tier_lagWar"))
rows_D <- twfe_war_rows(m_brd, "TWFE, log(1 + battle-related deaths)", "Full panel",
                        c("Per log-unit intensity" = "log_brd"))

# "displacement-quiet" sample: drop country-years inside a shock window so
# the war coefficient isn't soaking up concurrent displacement treatment
quiet_flags <- build_cyv_shock_panel("unhcr_total_displaced",
                                     QUIET_ABS_T, QUIET_GROWTH_T, QUIET_WINDOW) %>%
  distinct(Country.Code, Year, treat, event_time) %>%
  mutate(in_shock_window = treat == 1L & !is.na(event_time) &
           event_time >= 0 & event_time <= (QUIET_WINDOW - 1)) %>%
  distinct(Country.Code, Year, in_shock_window)

war_panel_quiet <- war_panel %>%
  left_join(quiet_flags, by = c("Country.Code", "Year")) %>%
  dplyr::filter(!coalesce(in_shock_window, FALSE))

m_tier_q <- feols(Coverage ~ conflict_tier + GDP_lag | id_var + Year,
                  data = war_panel_quiet, cluster = ~Country.Code)
rows_E <- twfe_war_rows(m_tier_q, "TWFE, contemporaneous conflict tier",
                        sprintf("Excl. displacement-shock windows (\u2265%s, %s%%, Y1\u2013%d)",
                                scales::comma(QUIET_ABS_T), QUIET_GROWTH_T * 100, QUIET_WINDOW),
                        c("Low-level (25\u2013999 brd)" = "conflict_tierLow-level",
                          "War (\u22651,000 brd)"        = "conflict_tierWar"))

# war-onset CS: clean onsets vs never-war (left-censored countries dropped
# entirely -- neither clean treated nor clean control)
cs_war_data <- war_panel %>%
  dplyr::filter(!ever_war | clean_onset) %>%
  mutate(g_var  = if_else(clean_onset, as.integer(first_war_year), 0L),
         id_int = as.integer(as.factor(id_var)),
         Year   = as.integer(Year)) %>%
  dplyr::filter(!is.na(Coverage))

n_cs_war_treated <- n_distinct(cs_war_data$Country.Code[cs_war_data$g_var > 0])

cs_att_war <- tryCatch(
  suppressWarnings(did::att_gt(
    yname = "Coverage", tname = "Year", idname = "id_int", gname = "g_var",
    xformla = ~ GDP_lag, data = cs_war_data %>% dplyr::filter(!is.na(GDP_lag)),
    control_group = "nevertreated", clustervars = "Country.Code",
    panel = TRUE, allow_unbalanced_panel = TRUE,
    base_period = "universal", est_method = "reg", print_details = FALSE)),
  error = function(e) NULL)
cs_war_adj <- if (!is.null(cs_att_war)) "GDP_lag" else "\u2014"
if (is.null(cs_att_war)) {
  message("[ST9] adjusted war-onset att_gt failed; running unadjusted")
  cs_att_war <- tryCatch(
    suppressWarnings(did::att_gt(
      yname = "Coverage", tname = "Year", idname = "id_int", gname = "g_var",
      data = cs_war_data, control_group = "nevertreated", clustervars = "Country.Code",
      panel = TRUE, allow_unbalanced_panel = TRUE,
      base_period = "universal", print_details = FALSE)),
    error = function(e) NULL)
  if (!is.null(cs_att_war)) cs_war_adj <- "unadjusted"
}

cs_war_row <- function(win_lab, max_e) {
  out <- tibble(specification = "Callaway\u2013Sant'Anna, war onset",
                sample = sprintf("Clean onsets (n=%d) vs never-war; %s",
                                 n_cs_war_treated, cs_war_adj),
                estimand = sprintf("Onset ATT, %s", win_lab),
                estimate = "\u2014", n_obs = NA_integer_,
                n_war_ctry = n_cs_war_treated, notes = "")
  if (is.null(cs_att_war)) return(out %>% mutate(notes = "att_gt failed"))
  agg <- tryCatch(did::aggte(cs_att_war, type = "dynamic",
                             min_e = 0, max_e = max_e, na.rm = TRUE),
                  error = function(e) NULL)
  if (!is.null(agg)) out$estimate <- fmt_est_ci(agg$overall.att, agg$overall.se)
  hdid <- tryCatch(run_honestdid_sensitivity(cs_att_war, event_time = 0, min_e = -3,
                                             max_e = max_e, aggregate = (max_e > 0)),
                   error = function(e) NULL)
  pt <- if (!is.null(cs_att_war$Wpval) && !is.na(cs_att_war$Wpval))
    sprintf("pre-trend p=%.3f", cs_att_war$Wpval) else "pre-trend p: \u2014"
  mb <- if (is.null(hdid) || is.na(hdid$cs_breakdown_mbar[1])) "M\u0304: \u2014" else
    if (hdid$cs_breakdown_mbar[1] > MBAR_MAX) sprintf("M\u0304 > %.1f", MBAR_MAX) else
      sprintf("M\u0304 = %.2f", hdid$cs_breakdown_mbar[1])
  out$notes <- paste(pt, mb, sep = "; ")
  out
}
rows_F <- cs_war_row("Year 1", 0)
rows_G <- cs_war_row("Years 1\u20133", 2)

sa_war_row <- function(win_lab, window_size) {
  d_sa <- war_panel %>%
    dplyr::filter(!ever_war | clean_onset) %>%
    dplyr::filter(!ever_war |
                    (war_event_time >= -5 & war_event_time <= window_size - 1)) %>%
    mutate(cohort_war = if_else(clean_onset, as.integer(first_war_year), 10000L))
  m_sa <- tryCatch(
    feols(Coverage ~ sunab(cohort_war, Year) + GDP_lag | id_var + Year,
          data = d_sa, cluster = ~Country.Code), error = function(e) NULL)
  est <- "\u2014"
  if (!is.null(m_sa)) {
    agg <- tryCatch(summary(m_sa, agg = "att"), error = function(e) NULL)
    if (!is.null(agg)) {
      ct <- agg$coeftable
      r <- ct[grepl("ATT", rownames(ct), ignore.case = TRUE), , drop = FALSE]
      if (nrow(r) >= 1) est <- fmt_est_ci(r[1, 1], r[1, 2])
    }
  }
  tibble(specification = "Sun\u2013Abraham, war onset",
         sample = sprintf("Clean onsets (n=%d) vs never-war", n_cs_war_treated),
         estimand = sprintf("Onset ATT, %s", win_lab),
         estimate = est, n_obs = if (!is.null(m_sa)) nobs(m_sa) else NA_integer_,
         n_war_ctry = n_cs_war_treated, notes = "")
}
rows_H <- sa_war_row("Year 1", 1)
rows_I <- sa_war_row("Years 1\u20133", 3)

supp_table9_war <- bind_rows(rows_A, rows_B, rows_C, rows_D, rows_E,
