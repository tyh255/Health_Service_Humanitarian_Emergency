# ------------------------------------------------------------
# 5. OMITTED-VARIABLE-BIAS SENSITIVITY (sensemakr)
# ------------------------------------------------------------
# the OVB target is the additive `post` coefficient (sensemakr needs one
# treatment coef), fit on the same sample / FE / clustering as Table 3.
library(sensemakr)

build_did_frame <- function(df, abs_t, growth_t, window_size = 1) {
  df %>%
    group_by(Country.Code, vaccine) %>%
    arrange(Year, .by_group = TRUE) %>%
    mutate(
      lag_total = dplyr::lag(unhcr_total_displaced),
      growth = if_else(!is.na(lag_total) & lag_total > 0,
                       (unhcr_total_displaced - lag_total) / lag_total, NA_real_),
      shock = case_when(
        is.na(growth) ~ 0L,
        growth >= growth_t & unhcr_total_displaced >= abs_t ~ 1L,
        TRUE ~ 0L)
    ) %>%
    group_by(Country.Code) %>%
    mutate(
      first_shock_year = if (any(shock == 1, na.rm = TRUE))
        min(Year[shock == 1], na.rm = TRUE) else NA_real_,
      treat = if_else(!is.na(first_shock_year), 1L, 0L),
      event_time = Year - first_shock_year
    ) %>%
    ungroup() %>%
    mutate(
      post = if_else(!is.na(event_time) & event_time >= 0 &
                       event_time < window_size, 1L, 0L),
      conflict_tier = factor(case_when(
        brd_new >= 1000 ~ "War",
        brd_new >= 25   ~ "Low-level",
        TRUE            ~ "None"), levels = c("None", "Low-level", "War")),
      id_var = paste(Country.Code, vaccine, sep = "_")
    ) %>%
    dplyr::filter(treat == 0L |
                    (treat == 1L & event_time >= -5 & event_time <= window_size - 1)) %>%
    dplyr::filter(!is.na(Coverage), !is.na(post), !is.na(conflict_tier),
                  !is.na(GDP_lag)) %>%
    droplevels()
}

# the trick: two fits on an identical sample, differing only in vcov.
# the iid fit feeds sensemakr (the Cinelli-Hazlett bias-bound geometry is
# an OLS quantity and needs the classical residual SD), while the clustered
# fit drives the actual inference and the headline robustness values.
# mixing them inside one sensemakr call gives you wrong RVs.
run_ovb_sensemakr <- function(df, abs_t, growth_t, window_size = 1,
                              kd = 1:3, q = 1, alpha = 0.05, verbose = TRUE) {

  df_mod <- build_did_frame(df, abs_t, growth_t, window_size)
  if (sum(df_mod$post, na.rm = TRUE) == 0) return(NULL)

  fml <- Coverage ~ post + conflict_tier + GDP_lag | id_var + Year
  m_clust <- tryCatch(feols(fml, data = df_mod, cluster = ~Country.Code),
                      error = function(e) NULL)
  m_iid   <- tryCatch(feols(fml, data = df_mod, vcov = "iid"),
                      error = function(e) NULL)
  if (is.null(m_clust) || is.null(m_iid)) return(NULL)

  b_post   <- unname(coef(m_clust)["post"])
  se_clust <- unname(sqrt(diag(vcov(m_clust)))["post"])
  G        <- n_distinct(df_mod$Country.Code)
  dof_cl   <- G - 1L

  bench <- c("GDP_lag", grep("^conflict_tier", names(coef(m_iid)), value = TRUE))
  sens <- tryCatch(
    sensemakr(model = m_iid, treatment = "post", benchmark_covariates = bench,
              kd = kd, ky = kd, q = q, alpha = alpha, reduce = TRUE),
    error = function(e) NULL)
  if (is.null(sens)) return(NULL)

  ss <- sens$sensitivity_stats; bd <- sens$bounds
  rv_q_point <- as.numeric(ss$rv_q)   # nullifying the point is variance-invariant

  # significance RV recomputed by hand under the clustered SE + G-1 dof --
  # sensemakr's own rv_qa uses OLS residual dof and isn't cluster-robust
  K_resid <- as.numeric(ss$se) * sqrt(as.numeric(ss$dof))
  clustered_sig_rv <- function(estimate, se_cl, dof, K, alpha = 0.05) {
    tcrit  <- qt(1 - alpha / 2, df = dof)
    adj_se <- se_cl * sqrt(dof / (dof - 1))
    f <- function(rv) (abs(estimate) - K * rv / sqrt(1 - rv)) - tcrit * adj_se
    if (f(1e-9) <= 0) return(0)
    tryCatch(uniroot(f, c(1e-9, 0.999))$root, error = function(e) NA_real_)
  }
  rv_qa_clust <- clustered_sig_rv(b_post, se_clust, dof_cl, K_resid, alpha)

  if (verbose) {
    cat(sprintf("\nOVB | abs>=%s, growth>=%s%%, window=%s\n",
                format(abs_t, big.mark = ","), growth_t * 100, window_size))
    cat(sprintf("post = %.3f | clustered SE = %.3f (dof %d) | classical SE = %.3f\n",
                b_post, se_clust, dof_cl, as.numeric(ss$se)))
    cat(sprintf("RV_q (point -> 0) = %.1f%% | RV_qa (sig -> 0, clustered) = %.1f%%\n",
                100 * rv_q_point, 100 * rv_qa_clust))
  }

  pick_adj <- function(label) {
    r <- bd[bd$bound_label == label, , drop = FALSE]
    if (nrow(r) == 0) NA_real_ else as.numeric(r$adjusted_estimate[1])
  }

  tibble(
    abs_threshold = abs_t, growth = paste0(growth_t * 100, "%"),
    window = window_size, n_obs = m_clust$nobs, n_countries = G,
    est_post = b_post, se_clustered = se_clust, se_classical = as.numeric(ss$se),
    partial_r2_post = as.numeric(ss$r2yd.x),
    RV_q_point      = rv_q_point,
    RV_qa_clustered = rv_qa_clust,
    adj_est_GDP_1x = pick_adj("1x GDP_lag"),
    adj_est_GDP_3x = pick_adj("3x GDP_lag"),
    adj_est_war_1x = pick_adj("1x conflict_tierWar"),
    adj_est_war_3x = pick_adj("3x conflict_tierWar")
  )
}

ovb_grid <- expand_grid(abs = c(50000, 250000, 500000, 750000),
                        growth = c(0.50, 1.0), win = c(1, 3)) %>%
  mutate(row = pmap(list(abs, growth, win),
                    ~ run_ovb_sensemakr(vaccine_long_updated, ..1, ..2, ..3,
                                        verbose = FALSE))) %>%
  dplyr::filter(!map_lgl(row, is.null)) %>%
  dplyr::select(row) %>% unnest(row)

print(ovb_grid, width = Inf, n = Inf)
write.csv(ovb_grid, "results/AppendixTable_OVB_sensemakr.csv", row.names = FALSE)
