library(mgcv)

PRIMARY_K <- 8   # k-sensitivity below defends this choice

df_gam <- vaccine_long_updated %>%
  mutate(
    log_displacement = log1p(unhcr_total_displaced),
    log_gdp = log1p(GDP_per_capita),
    country = factor(Country.Code),
    year    = factor(Year),
    vaccine = factor(vaccine)
  ) %>%
  filter(!is.na(Coverage), !is.na(percent_pop_displaced),
         !is.na(unhcr_total_displaced), !is.na(GDP_per_capita))

gam_pct <- gam(Coverage ~ s(percent_pop_displaced, k = PRIMARY_K) +
                 country + year + vaccine + log_gdp,
               data = df_gam, method = "REML", select = TRUE)
gam_abs <- gam(Coverage ~ s(log_displacement, k = PRIMARY_K) +
                 country + year + vaccine + log_gdp,
               data = df_gam, method = "REML", select = TRUE)

# predictions at median GDP, country/year smooths excluded, averaged over
# vaccines. (note: this conditions on reference levels rather than truly
# marginalizing -- the curve shape is unaffected.)
make_grid <- function(x_var, x_seq, data) {
  expand.grid(
    x_val   = x_seq,
    log_gdp = median(data$log_gdp, na.rm = TRUE),
    country = factor(levels(data$country)[1], levels = levels(data$country)),
    year    = factor(levels(data$year)[1],    levels = levels(data$year)),
    vaccine = factor(levels(data$vaccine),    levels = levels(data$vaccine))
  ) %>% rename(!!x_var := x_val)
}
predict_marginal <- function(model, newdata) {
  pr <- predict(model, newdata = newdata, se.fit = TRUE,
                exclude = c("country", "year"))
  newdata$fit <- pr$fit; newdata$se <- pr$se.fit
  newdata
}
aggregate_curve <- function(grid, x_var) {
  grid %>%
    group_by(!!sym(x_var)) %>%
    summarise(mean_fit = mean(fit), mean_se = mean(se), .groups = "drop") %>%
    arrange(!!sym(x_var)) %>%
    mutate(lower = mean_fit - 1.96 * mean_se, upper = mean_fit + 1.96 * mean_se)
}

pct_seq <- seq(0, min(50, max(df_gam$percent_pop_displaced, na.rm = TRUE)),
               length.out = 200)
agg_pct <- make_grid("percent_pop_displaced", pct_seq, df_gam) %>%
  predict_marginal(gam_pct, .) %>%
  aggregate_curve("percent_pop_displaced")

abs_seq <- seq(min(df_gam$log_displacement), max(df_gam$log_displacement),
               length.out = 200)
agg_abs <- make_grid("log_displacement", abs_seq, df_gam) %>%
  predict_marginal(gam_abs, .) %>%
  aggregate_curve("log_displacement") %>%
  mutate(displaced_persons = expm1(log_displacement))

# where does the curve cross a 3pp / 5pp drop from baseline, and where
# does it flatten out
extract_inflections <- function(agg_data, x_col) {
  agg <- agg_data %>% arrange(!!sym(x_col))
  baseline <- agg$mean_fit[1]
  plateau  <- min(agg$mean_fit, na.rm = TRUE)
  cross_at <- function(drop_pp) {
    hit <- which(agg$mean_fit <= baseline - drop_pp)
    if (length(hit) == 0) NA_real_ else agg[[x_col]][hit[1]]
  }
  plateau_idx <- which(agg$mean_fit <= plateau + 0.5)
  tibble(
    baseline_pct  = round(baseline, 2),
    plateau_pct   = round(plateau, 2),
    total_drop_pp = round(baseline - plateau, 2),
    x_at_3pp_drop = cross_at(3),
    x_at_5pp_drop = cross_at(5),
    plateau_onset_x = if (length(plateau_idx) > 0) agg[[x_col]][plateau_idx[1]] else NA_real_
  )
}

inflections <- bind_rows(
  extract_inflections(agg_pct, "percent_pop_displaced") %>%
    mutate(axis = "percent displaced", .before = 1),
  extract_inflections(agg_abs, "log_displacement") %>%
    mutate(across(c(x_at_3pp_drop, x_at_5pp_drop, plateau_onset_x),
                  ~ round(expm1(.), 0))) %>%
    mutate(axis = "absolute displacement", .before = 1)
)
print(inflections)
write.csv(inflections, "results/GAM_inflections.csv", row.names = FALSE)

# k-sensitivity: thresholds should be stable across basis dimensions
k_sensitivity <- function(k_val) {
  mod <- tryCatch(
    gam(Coverage ~ s(percent_pop_displaced, k = k_val) +
          country + year + vaccine + log_gdp,
        data = df_gam, method = "REML", select = TRUE),
    error = function(e) NULL)
  if (is.null(mod)) return(NULL)
  agg <- make_grid("percent_pop_displaced", pct_seq, df_gam) %>%
    predict_marginal(mod, .) %>%
    aggregate_curve("percent_pop_displaced")
  baseline <- agg$mean_fit[1]
  tibble(k = k_val, aic = AIC(mod),
         edf = summary(mod)$s.table[1, "edf"],
         pct_at_3pp = agg$percent_pop_displaced[which(agg$mean_fit <= baseline - 3)[1]],
         pct_at_5pp = agg$percent_pop_displaced[which(agg$mean_fit <= baseline - 5)[1]])
}
